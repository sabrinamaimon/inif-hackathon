# Backend Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Primary AI Provider: Groq (Ultra-fast, high free-tier limits)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary AI Fallback: Google Gemini (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://inif-hackathon.vercel.app
